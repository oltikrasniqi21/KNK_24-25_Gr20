<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="400.0" prefWidth="640.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ManageUsersController">
  <children>
    <MenuBar VBox.vgrow="NEVER">
      <menus>
        <Menu mnemonicParsing="false" text="%menu.file">
          <items>
            <MenuItem text="%menuitem.new" />
            <MenuItem text="%menuitem.open" />
            <Menu text="%menuitem.openrecent" />
            <SeparatorMenuItem />
            <MenuItem text="%menuitem.close" />
            <MenuItem text="%menuitem.save" />
            <MenuItem text="%menuitem.save_as" />
            <MenuItem text="%menuitem.revert" />
            <SeparatorMenuItem />
            <MenuItem text="%menuitem.preferences" />
            <SeparatorMenuItem />
            <MenuItem text="%menuitem.quit" />
          </items>
        </Menu>
        <Menu text="%menu.edit">
          <items>
            <MenuItem text="%menuitem.undo" />
            <MenuItem text="%menuitem.redo" />
            <SeparatorMenuItem />
            <MenuItem text="%menuitem.cut" />
            <MenuItem text="%menuitem.copy" />
            <MenuItem text="%menuitem.paste" />
            <MenuItem text="%menuitem.delete" />
            <SeparatorMenuItem />
            <MenuItem text="%menuitem.select_all" />
            <MenuItem text="%menuitem.unselect_all" />
          </items>
        </Menu>
        <Menu text="%menu.help">
          <items>
            <MenuItem text="%menuitem.about" />
          </items>
        </Menu>
      </menus>
    </MenuBar>
    <AnchorPane VBox.vgrow="ALWAYS">
      <children>
        <Label layoutX="34.0" layoutY="20.0" text="%label.manage_users">
          <font>
            <Font size="18.0" />
          </font>
        </Label>
        <TextField layoutX="34.0" layoutY="58.0" promptText="%textfield.search_user" />
        <Button fx:id="btnSearch" layoutX="200.0" layoutY="58.0" onAction="#handleSearchClick" text="%button.search" />
        <TableView fx:id="usersTable" layoutX="34.0" layoutY="105.0" prefHeight="240.0" prefWidth="574.0">
          <columns>
            <TableColumn fx:id="userIdColumn" prefWidth="80" text="%column.id" />
            <TableColumn fx:id="userNameColumn" prefWidth="113.0" text="%column.name" />
            <TableColumn fx:id="userEmailColumn" prefWidth="135.0" text="%column.email" />
            <TableColumn fx:id="userStatusColumn" prefWidth="103.0" text="%column.status" />
            <TableColumn fx:id="actionButtonColumn" prefWidth="142.0" text="%column.document" />
          </columns>
        </TableView>
        <Button fx:id="btnAddUser" layoutX="220.0" layoutY="21.0" onAction="#handleAddUserClick" text="%button.add_user" />
        <Button fx:id="btnBack" layoutX="558.0" layoutY="21.0" onAction="#handleBackClick" prefHeight="25.0" prefWidth="49.0" text="%button.back" />
            <Button fx:id="validateButton" layoutX="377.0" layoutY="21.0" mnemonicParsing="false" prefHeight="25.0" prefWidth="63.0" text="%button.validate" underline="true" onAction="#handleValidate"  />
            <Button  fx:id="rejectButton" layoutX="452.0" layoutY="21.0" mnemonicParsing="false" text="%button.reject" underline="true" onAction="#handleReject" />
      </children>
    </AnchorPane>
  </children>
</VBox>
