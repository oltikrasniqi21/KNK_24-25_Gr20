<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="400.0" prefWidth="640.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ManageScholarshipsController">
    <children>
        <MenuBar VBox.vgrow="NEVER">
            <menus>
                <Menu mnemonicParsing="false" text="%menu.file">
                    <items>
                        <MenuItem text="%menuitem.new" />
                        <MenuItem text="%menuitem.open" />
                        <Menu text="%menuitem.openrecent" />
                        <SeparatorMenuItem />
                        <MenuItem text="%menuitem.close" />
                        <MenuItem text="%menuitem.save" />
                        <MenuItem text="%menuitem.save_as" />
                        <MenuItem text="%menuitem.revert" />
                        <SeparatorMenuItem />
                        <MenuItem text="%menuitem.preferences" />
                        <SeparatorMenuItem />
                        <MenuItem text="%menuitem.quit" />
                    </items>
                </Menu>
                <Menu text="%menu.edit">
                    <items>
                        <MenuItem text="%menuitem.undo" />
                        <MenuItem text="%menuitem.redo" />
                        <SeparatorMenuItem />
                        <MenuItem text="%menuitem.cut" />
                        <MenuItem text="%menuitem.copy" />
                        <MenuItem text="%menuitem.paste" />
                        <MenuItem text="%menuitem.delete" />
                        <SeparatorMenuItem />
                        <MenuItem text="%menuitem.select_all" />
                        <MenuItem text="%menuitem.unselect_all" />
                    </items>
                </Menu>
                <Menu text="%menu.help">
                    <items>
                        <MenuItem text="%menuitem.about" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
        <AnchorPane VBox.vgrow="ALWAYS">
            <children>
                <Button fx:id="btnAddUser" layoutX="227.0" layoutY="21.0" onAction="#handleAddScholarshipClick" text="%add_scholarship" />
                <Label layoutX="34.0" layoutY="20.0" text="%manage_scholarships">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>
                <TextField fx:id="searchStudent" layoutX="34.0" layoutY="58.0" promptText="%search_scholarship" />
                <Button fx:id="btnSearch" layoutX="200.0" layoutY="58.0" onAction="#handleSearchClick" text="%search" />
                <TableView layoutX="8.0" layoutY="105.0" prefHeight="240.0" prefWidth="622.0">
                    <columns>
                        <TableColumn fx:id="scholarshipsIdColumn" prefWidth="75.0" text="%column.id" />
                        <TableColumn fx:id="scholarshipsNameColumn" prefWidth="75.0" text="%column.name" />
                        <TableColumn fx:id="scholarshipsProviderColumn" prefWidth="75.0" text="%column.institute" />
                        <TableColumn fx:id="scholarshipsAmountColumn" prefWidth="75.0" text="%column.vlera" />
                        <TableColumn fx:id="scholarshipsDeadlineColumn" prefWidth="75.0" text="%column.deadline" />
                        <TableColumn fx:id="scholarshipsGpaColumn" prefWidth="75.0" text="%gpa" />
                        <TableColumn fx:id="scholarshipsYearColumn" prefWidth="75.0" text="%col.year" />
                        <TableColumn fx:id="scholarshipsMajorColumn" prefWidth="75.0" text="%column.drejtimi" />
                    </columns>
                </TableView>
                <Button fx:id="btnBack" layoutX="528.0" layoutY="21.0" onAction="#handleBackClick" prefHeight="26.0" prefWidth="80.0" text="%back" />
            </children>
        </AnchorPane>
    </children>
</VBox>
