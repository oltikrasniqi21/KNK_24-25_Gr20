<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="400.0" prefWidth="685.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ListStudentsController">
   <children>
      <MenuBar VBox.vgrow="NEVER">
         <menus>
            <Menu mnemonicParsing="false" text="%menu.file">
               <items>
                  <MenuItem mnemonicParsing="false" text="%menu.file.new" />
                  <MenuItem mnemonicParsing="false" text="%menu.file.open" />
                  <Menu mnemonicParsing="false" text="%menu.file.openRecent" />
                  <SeparatorMenuItem mnemonicParsing="false" />
                  <MenuItem mnemonicParsing="false" text="%menu.file.close" />
                  <MenuItem mnemonicParsing="false" text="%menu.file.save" />
                  <MenuItem mnemonicParsing="false" text="%menu.file.saveAs" />
                  <MenuItem mnemonicParsing="false" text="%menu.file.revert" />
                  <SeparatorMenuItem mnemonicParsing="false" />
                  <MenuItem mnemonicParsing="false" text="%menu.file.preferences" />
                  <SeparatorMenuItem mnemonicParsing="false" />
                  <MenuItem mnemonicParsing="false" text="%menu.file.quit" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="%menu.edit">
               <items>
                  <MenuItem mnemonicParsing="false" text="%menu.edit.undo" />
                  <MenuItem mnemonicParsing="false" text="%menu.edit.redo" />
                  <SeparatorMenuItem mnemonicParsing="false" />
                  <MenuItem mnemonicParsing="false" text="%menu.edit.cut" />
                  <MenuItem mnemonicParsing="false" text="%menu.edit.copy" />
                  <MenuItem mnemonicParsing="false" text="%menu.edit.paste" />
                  <MenuItem mnemonicParsing="false" text="%menu.edit.delete" />
                  <SeparatorMenuItem mnemonicParsing="false" />
                  <MenuItem mnemonicParsing="false" text="%menu.edit.selectAll" />
                  <MenuItem mnemonicParsing="false" text="%menu.edit.unselectAll" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="%menu.help">
               <items>
                  <MenuItem mnemonicParsing="false" text="%menu.help.about" />
               </items>
            </Menu>
         </menus>
      </MenuBar>
      <AnchorPane maxHeight="-1.0" maxWidth="-1.0" prefHeight="375.0" prefWidth="705.0" VBox.vgrow="ALWAYS">
         <children>
            <Label alignment="CENTER" layoutX="270.0" layoutY="14.0" text="%label.studentsList" textAlignment="CENTER" textFill="#9f9f9f" wrapText="false">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>
            <TextField layoutX="17.0" layoutY="63.0" promptText="%prompt.searchStudent" />
            <Button fx:id="btnSearch" layoutX="183.0" layoutY="63.0" mnemonicParsing="false" onAction="#handleSearchClick" prefHeight="25.0" prefWidth="59.0" text="%button.search" />
            <TableView fx:id="studentsTable" layoutY="96.0" prefHeight="364.0" prefWidth="780.0">
               <columns>
                  <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
                  <TableColumn fx:id="gpaColumn" prefWidth="70.0" text="Mesatarja" />
                  <TableColumn fx:id="yearColumn" prefWidth="50.0" text="Viti" />
                  <TableColumn fx:id="universityColumn" prefWidth="120.0" text="Universiteti" />
                  <TableColumn fx:id="facultyColumn" prefWidth="120.0" text="Fakulteti" />
                  <TableColumn fx:id="majorColumn" prefWidth="120.0" text="Drejtimi" />
                  <TableColumn fx:id="semesterColumn" prefWidth="70.0" text="Semestri" />
                  <TableColumn fx:id="priorityColumn" prefWidth="80.0" text="Prioriteti" />
                  <TableColumn fx:id="statusColumn" prefWidth="80.0" text="Statusi" />
               </columns>
            </TableView>
            <Button fx:id="btnBack" layoutX="621.0" layoutY="26.0" mnemonicParsing="false" onAction="#handleBackClick" prefHeight="25.0" prefWidth="49.0" text="%button.back" />
         </children>
      </AnchorPane>
   </children>
</VBox>
