<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="400.0" prefWidth="685.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.StudentListController">
   <children>
      <MenuBar VBox.vgrow="NEVER">

         <menus>
            <Menu mnemonicParsing="false" text="File">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#handleClose" text="Close" />
               </items>
            </Menu>
         </menus>
      </MenuBar>

      <AnchorPane maxHeight="-1.0" maxWidth="-1.0" prefHeight="375.0" prefWidth="705.0" VBox.vgrow="ALWAYS">
         <children>
            <Label alignment="CENTER" layoutX="270.0" layoutY="14.0" text="Students List" textAlignment="CENTER" textFill="#9f9f9f" wrapText="false">
               <font>
                  <Font size="18.0" />
               </font>
            </Label>

            <TextField fx:id="searchField" layoutX="17.0" layoutY="63.0" promptText="%searchf.prompt" />
            <Button fx:id="btnSearch" layoutX="183.0" layoutY="63.0" mnemonicParsing="false" onAction="#handleSearch" text="%button.serach" />

            <TableView fx:id="studentslistTable" layoutY="122.0" prefHeight="340.0" prefWidth="780.0">
               <columns>
                  <TableColumn fx:id="StudentIdColumn" prefWidth="50.0" text="ID" />
                  <TableColumn fx:id="studentNameColumn" prefWidth="150.0" text="Name" />
                  <TableColumn fx:id="studentGpaColumn" prefWidth="70.0" text="GPA" />
                  <TableColumn fx:id="studentYearColumn" prefWidth="50.0" text="Year" />
                  <TableColumn fx:id="studentUniversityColumn" prefWidth="120.0" text="University" />
                  <TableColumn fx:id="studentFacultyColumn" prefWidth="120.0" text="Faculty" />
                  <TableColumn fx:id="studentMajorColumn" prefWidth="86.0" text="Major" />
                  <TableColumn fx:id="studentPriorityColumn" minWidth="0.0" prefWidth="68.0" text="Priority" />
                  <TableColumn fx:id="studentsStringTableColumnStatus" prefWidth="65.0" text="Status" />
               </columns>
            </TableView>

            <Button fx:id="btnBack" layoutX="621.0" layoutY="26.0" mnemonicParsing="false" onAction="#handleClose" text="Back" />
         </children>
      </AnchorPane>
   </children>
</VBox>
