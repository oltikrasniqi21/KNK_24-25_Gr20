<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="mainLayout" stylesheets="@../css/create_users.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.CreateUsersController">
   <center>
      <VBox alignment="CENTER" prefHeight="400.0" prefWidth="600.0" BorderPane.alignment="CENTER">
      
          <children>
                <Label text="%label.firstname" />
                <TextField fx:id="txtEmri" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" prefHeight="25.0" prefWidth="200.0" />
            <HBox prefHeight="15.0" prefWidth="600.0" />
      
                <Label text="%label.lastname" />
                <TextField fx:id="txtMbiemri" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" prefHeight="25.0" prefWidth="200.0" />
            <HBox prefHeight="15.0" prefWidth="600.0" />
      
                <Label text="%label.email" />
                <TextField fx:id="txtEmail" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" prefHeight="25.0" prefWidth="200.0" />
            <HBox minHeight="-Infinity" prefHeight="15.0" prefWidth="600.0" />
      
                <Label text="%label.password" />
                <PasswordField fx:id="pwdPassword" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" prefHeight="25.0" prefWidth="200.0" />
            <HBox prefHeight="30.0" prefWidth="600.0" />
      
                <Button fx:id="btnShtoUser" onAction="#handleShtoUserClick" text="%button.addUser" />
            <HBox prefHeight="40.0" prefWidth="600.0" />
          </children>
      </VBox>
   </center>
</BorderPane>
