<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="mainLayout" stylesheets="@../css/student_view.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.StudentHomePageController">
   <right>
       <VBox fx:id="notificationPane" layoutX="253.0" layoutY="71.0" maxHeight="-Infinity" minHeight="-Infinity" prefHeight="342.0" prefWidth="500.0">
       <children>
            <TableView fx:id="notificationTable" maxHeight="-Infinity" minHeight="-Infinity" prefHeight="340.0" prefWidth="500.0" BorderPane.alignment="CENTER">
                <columns>
                    <TableColumn fx:id="messageColumn" prefWidth="340" text="%messageNotificationStd" />
                     <TableColumn fx:id="dateColumn" prefWidth="160" text="%dateNotificationStd" />
                 </columns>
             </TableView>
       </children>
       </VBox>
   </right>
   <center>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0">
         <children>
            <HBox alignment="CENTER" prefHeight="410.0" prefWidth="635.0">
               <children>
                  <Label fx:id="welcome" text="%welcome.label" />
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
   <top>
      <HBox fx:id="topHbox" alignment="CENTER" prefHeight="61.0" prefWidth="826.0" BorderPane.alignment="CENTER">
         <children>
             <VBox fx:id="languagesHbox" alignment="CENTER" maxWidth="Infinity" spacing="10">
                 <Button layoutX="31.0" layoutY="9.0" mnemonicParsing="false" onAction="#handleENLanguageClick" prefHeight="27.0" prefWidth="109.0" text="%english.button">
                     <styleClass>
                         <String fx:value="englishButton" />
                         <String fx:value="Button" />
                     </styleClass>
                 </Button>
                 <Button layoutX="152.0" layoutY="9.0" mnemonicParsing="false" onAction="#handleSQLanguageClick" prefHeight="27.0" prefWidth="100.0" text="%shqip.button">
                     <styleClass>
                         <String fx:value="shqipButton" />
                         <String fx:value="Button" />
                     </styleClass>
                 </Button>
             </VBox>
            <Button mnemonicParsing="false" onAction="#handleLogout" text="%btn.logout" />
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#loadNewsStudent" text="%newsStdHome" />
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#loadFAQ" text="%viewFaq" />
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#loadFeedbackForm" text="%giveFeedbackBtn" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnViewApplication" mnemonicParsing="false" onAction="#onViewApplicationClicked" text="%viewApplication" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnViewNotifications" mnemonicParsing="false" onAction="#onViewNotificationsClicked" text="%viewNotificationsBtn" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnViewProfile" mnemonicParsing="false" onAction="#handleViewProfileClick" text="%viewProfile" />
         </children>
      </HBox>
   </top>
</BorderPane>
