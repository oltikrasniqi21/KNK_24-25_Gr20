<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="mainLayout" stylesheets="@../css/student_view.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.StudentHomePageController">
   <left>
      <VBox prefHeight="342.0" prefWidth="141.0" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#handleLogout" prefHeight="26.0" prefWidth="148.0" text="%btn.logout" />
            <Button mnemonicParsing="false" onAction="#loadFAQ" prefHeight="26.0" prefWidth="154.0" text="%viewFaq" />
            <Button fx:id="btnViewNotifications" mnemonicParsing="false" onAction="#onViewNotificationsClicked" prefHeight="26.0" prefWidth="152.0" text="%viewNotificationsBtn" />
            <Button mnemonicParsing="false" onAction="#loadFeedbackForm" prefHeight="25.0" prefWidth="145.0" text="%giveFeedbackBtn" />
         </children>
      </VBox>
   </left>
   <top>
      <Pane prefHeight="58.0" prefWidth="600.0" BorderPane.alignment="CENTER" />
   </top>
   <right>
       <VBox fx:id="notificationPane" layoutX="253.0" layoutY="71.0" prefHeight="342.0" prefWidth="152.0">
       <children>
            <TableView fx:id="notificationTable" prefHeight="200.0" prefWidth="163.0" BorderPane.alignment="CENTER">
                <columns>
                    <TableColumn fx:id="messageColumn" prefWidth="75.0" text="%messageNotificationStd" />
                     <TableColumn fx:id="dateColumn" prefWidth="75.0" text="%dateNotificationStd" />
                 </columns>
             </TableView>
       </children>
       </VBox>
   </right>
</BorderPane>
