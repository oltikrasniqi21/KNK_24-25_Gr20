<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="mainLayout" stylesheets="@../css/student_view.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.StudentHomePageController">
   <left>
      <VBox fx:id="leftVbox" prefHeight="342.0" prefWidth="176.0" BorderPane.alignment="CENTER">
         <children>
            <Button mnemonicParsing="false" onAction="#handleLogout" prefHeight="26.0" prefWidth="320.0" text="%btn.logout" />
            <Button mnemonicParsing="false" onAction="#loadFAQ" prefHeight="26.0" prefWidth="307.0" text="%viewFaq" />
            <Button mnemonicParsing="false" onAction="#loadFeedbackForm" prefHeight="26.0" prefWidth="243.0" text="%giveFeedbackBtn" />
            <Button fx:id="btnViewNotifications" mnemonicParsing="false" onAction="#onViewNotificationsClicked" prefHeight="26.0" prefWidth="260.0" text="%viewNotificationsBtn" />
            <Button fx:id="btnViewApplication" mnemonicParsing="false" onAction="#onViewApplicationClicked" prefHeight="26.0" prefWidth="260.0" text="%viewApplication" />
            <Button fx:id="btnViewProfile" mnemonicParsing="false" onAction="#handleViewProfileClick" prefHeight="26.0" prefWidth="260.0" text="%viewProfile" />
            <Button mnemonicParsing="false" onAction="#loadNewsStudent" prefHeight="33.0" prefWidth="216.0" text="Button" />
         </children>
      </VBox>
   </left>
   <right>
       <VBox fx:id="notificationPane" layoutX="253.0" layoutY="71.0" prefHeight="342.0" prefWidth="256.0">
       <children>
            <TableView fx:id="notificationTable" prefHeight="200.0" prefWidth="163.0" BorderPane.alignment="CENTER">
                <columns>
                    <TableColumn fx:id="messageColumn" prefWidth="75.0" text="%messageNotificationStd" />
                     <TableColumn fx:id="dateColumn" prefWidth="75.0" text="%dateNotificationStd" />
                 </columns>
             </TableView>
            <Pane prefHeight="200.0" prefWidth="200.0" />
       </children>
       </VBox>
   </right>
   <center>
      <Pane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
